# --- Connection ------------------------------------------------------------

HONEYBEE_SSH_HOST=              # Hostname, IP or ~/.ssh/config alias of the application server (required).

HONEYBEE_SSH_USER=
HONEYBEE_SSH_PORT=
HONEYBEE_SSH_IDENTITY_FILE=

HONEYBEE_APP_PATH=              # Absolute path of the application on the server (required).
HONEYBEE_REMOTE_PHP=php         # PHP binary on the server.

HONEYBEE_FRAMEWORK=laravel      # Framework of the application. Only "laravel" is supported for now.

HONEYBEE_HEALTH_URL=            # URL checked for health (any 2xx = up). Leave empty to use the app's APP_URL + /up.
HONEYBEE_HEALTH_TIMEOUT=5       # Seconds before a health check counts as failed.

# --- Display ---------------------------------------------------------------

HONEYBEE_REFRESH_INTERVAL=30    # Seconds between storage scans and health checks.
